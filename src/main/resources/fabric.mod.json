{
  "schemaVersion": 1,
  "id": "soundboardplus",
  "version": "${version}",
  "name": "Soundboard+",
  "description": "An enhanced fork of Simple Soundboard by kvxd",
  "authors": [
    "kvxd (Original)",
    "Wolmics"
  ],
  "contact": {
    "homepage": "https://github.com/wolmics/SoundboardPlus",
    "issues": "https://github.com/wolmics/SoundboardPlus",
    "sources": "https://github.com/wolmics/SoundboardPlus"
  },
  "license": "GPL-3.0",
  "environment": "client",
  "icon": "assets/soundboardplus/icon.png",
  "entrypoints": {
    "client": [
      "org.wolmics.soundboardplus.SimpleSoundboardClient"
    ],
    "voicechat": [
      "org.wolmics.soundboardplus.integration.SoundboardPlugin"
    ],
    "modmenu": [
      "org.wolmics.soundboardplus.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "soundboardplus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "voicechat_api": ">=${voicechat_api_version}"
  }
}
